# Folio only uses real sandbox and translation connections.
HOST=127.0.0.1
PORT=3210
DATA_DIR=.runtime
RETENTION_DAYS=30
# Required when HOST is not loopback. Store the real value outside Git.
APP_PASSWORD=
# First setup is required by default. On public deployments set a random code
# in this root-managed file; the setup wizard requires it before claiming.
FOLIO_SETUP_TOKEN_FILE=
# Enable only behind a trusted loopback reverse proxy.
TRUST_PROXY=0

# Run cc-sandbox locally or forward its private port to loopback.
CC_SANDBOX_URL=http://127.0.0.1:8123
# Prefer a file readable by the WebUI service user. Never expose it to the browser.
CC_SANDBOX_TOKEN_FILE=
CC_SANDBOX_TOKEN=
# Run `claude setup-token` in your trusted terminal. May also be supplied in the setup wizard (encrypted server storage).
CLAUDE_CODE_OAUTH_TOKEN=

# OpenAI-compatible base URL, no /chat/completions suffix.
# Local option: ollama pull qwen2.5:7b; use http://127.0.0.1:11434/v1
TRANSLATOR_URL=
TRANSLATOR_MODEL=qwen2.5:7b
TRANSLATOR_PROTOCOL=auto
TRANSLATOR_API_KEY=
# Optional separate vision model for generated output images. Empty values inherit text translation settings.
VISION_TRANSLATOR_MODEL=
VISION_TRANSLATOR_URL=
VISION_TRANSLATOR_KEY=
