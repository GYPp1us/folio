[Unit]
Description=Folio isolated publication gateway
After=docker.service cc-sandbox.service
Requires=docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/folio/gateway/report-gateway.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
