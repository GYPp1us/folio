[Unit]
Description=Folio Claude Code workspace
After=network-online.target cc-sandbox.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=folio
Group=folio
WorkingDirectory=/opt/folio/current
EnvironmentFile=/etc/folio/webui.env
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/node --import tsx server/index.ts
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/folio
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
